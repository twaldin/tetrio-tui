{
  "_comment": "TETR.IO Ribbon protocol command registry (client v1.7.8, 2026). Code 43 = generic theorypack channel; other codes are dedicated compact encodings.",
  "dedicated": {
    "25": {
      "name": "new",
      "flags": [
        "F_ALLOC"
      ],
      "desc": "client hello on fresh connection (no payload)"
    },
