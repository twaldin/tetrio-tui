      "name": "ping",
      "flags": [
        "F_HOOK"
      ],
      "data": {
        "recvid": "u32be"
      },
      "desc": "ping/pong both directions, recvid = last received msg id"
    },
    "44": {
      "name": "session",
      "flags": [],
      "data": {
        "ribbonid": "8 bytes hex",
        "tokenid": "8 bytes hex"
      },
      "desc": "session id exchange / resume"
    },
    "7": {
      "name": "packets",
      "flags": [],
      "data": {
        "packets": "[u32be len + bytes]..."
      },
      "desc": "batch of nested packets"
    },
    "4": {
      "name": "kick",
      "flags": [
        "F_HOOK"
      ],
      "data": {
        "reason": "u8 table {outdated:1,kick:2,restrict:3,block:4,anticheat:5,manual:6,rename:7} or utf8 string"
      }
    },
    "42": {
      "name": "nope",
      "flags": [],
      "data": {
        "reason": "u8 table {protocol violation:0, ribbon expired:1}"
      }
    },
    "51": {
      "name": "pni",
      "flags": [
        "F_HOOK"
      ],
      "data": {
        "type": "u8 {background:0, split:1, load:2}",
        "timeout": "u16be"
      },
      "desc": "pre-migrate notification"
    },
    "49": {
      "name": "notify",
      "flags": [
        "F_HOOK",
        "F_ID"
      ],
      "data": {
        "type": "u8 {deny:1,warm:2,ok:3,error:4,announce:5}",
        "timeout": "u16be (deny only)",
        "msg": "utf8"
      }
    },
    "43": {
      "name": "__pack__",
      "flags": [
        "F_ID"
      ],
      "desc": "generic theorypack channel: payload = u8 command_code + msgpackr(data)"
    }
  },
