{
  "name": "tetrio-tui",
  "version": "1.1.5",
  "description": "A terminal client for TETR.IO \u2014 play Tetra League and custom rooms in your terminal.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tetrio-tui": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tui": "vitest run --config vitest.tui.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "msgpackr": "^1.11.14",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tuistory": "^0.4.0"
  }
}